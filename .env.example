# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase (PostgreSQL + PostGIS + Auth + Storage)
VITE_SUPABASE_URL="https://xyzproject.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Web Push Notifications (VAPID Keys)
VITE_VAPID_PUBLIC_KEY="BEl62iUYgUivxIkv69yViEuiBIa-Ib9-Skv..."
VAPID_PRIVATE_KEY="YOUR_PRIVATE_VAPID_KEY"
VAPID_SUBJECT="mailto:civicops@nagrikpulse.gov.in"

# Resend Email Delivery (Free tier: 100 emails/day, 3,000/month)
RESEND_API_KEY="re_123456789_abcdef"
NOTIFICATION_FROM_EMAIL="alerts@nagrikpulse.gov.in"

# Sentry Error Tracking (Free tier: 5,000 errors/month)
SENTRY_DSN="https://key@o0.ingest.sentry.io/0"

# OpenStreetMap / MapLibre Tile Server (Default: OpenStreetMap Free Raster Tiles)
VITE_MAP_TILE_URL="https://tile.openstreetmap.org/{z}/{x}/{y}.png"

